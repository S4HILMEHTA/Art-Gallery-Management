@startuml
title Use Case Diagram - Art Gallery Management System
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1F3864
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1F3864
}
left to right direction

actor "Gallery Manager" as GM
actor "Customer" as CU

rectangle "Art Gallery Management System" {
  usecase "Add / Update / Delete\nRecords" as UC1
  usecase "Organize Exhibition" as UC4
  usecase "Generate Reports" as UC7
  usecase "Save / Load Data" as UC8
  usecase "Display Records" as UC2
  usecase "Search Record" as UC3
  usecase "Sell / Buy Artwork" as UC5
  usecase "Cancel Sale" as UC6
  usecase "Validate Input" as UC12
}

GM -- UC1
GM -- UC4
GM -- UC7
GM -- UC8
GM -- UC2
GM -- UC3
GM -- UC5
GM -- UC6

UC2 -- CU
UC3 -- CU
UC5 -- CU
UC6 -- CU

UC1 ..> UC12 : <<include>>
UC4 ..> UC12 : <<include>>
UC5 ..> UC12 : <<include>>
@enduml
